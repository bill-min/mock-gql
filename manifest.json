{
  "manifest_version": 3,
  "name": "MockGQL",
  "version": "1.1.1",
  "description": "DevTools extension to log and mock GraphQL requests",
  "devtools_page": "devtools.html",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/injected.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "128": "icons/icon.png"
  }
}
